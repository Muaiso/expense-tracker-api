# Beispiel-Umgebungsvariablen (kopieren nach .env und anpassen).
# Die Anwendung liest zurzeit application.properties; diese Datei dient
# als Vorlage fuer ein spaeteres Docker-/Compose-Setup.

SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:h2:mem:expensesdb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_H2_CONSOLE_ENABLED=true
