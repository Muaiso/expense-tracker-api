# Text files use LF in the repo regardless of the platform checkout.
* text=auto eol=lf

*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Windows launcher scripts keep CRLF.
*.bat text eol=crlf
gradlew text eol=lf

# Binary assets.
*.jar binary
*.png binary
*.jpg binary
